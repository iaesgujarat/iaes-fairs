# =============================================================
# IAES Fairs — Environment Variables
# Copy this file to .env.local and fill in actual values.
# =============================================================

# ---- Supabase --------------------------------------------------
# Get these from your Supabase project: Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://wpmhbfegrjenqbjvavxf.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Keep this SECRET — never expose to the client.
SUPABASE_SERVICE_ROLE_KEY=

# ---- Razorpay --------------------------------------------------
# Get these from Razorpay Dashboard > Settings > API Keys
# Use test-mode keys (rzp_test_...) for development.
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=

# Get this from Razorpay Dashboard > Settings > Webhooks
# Webhook endpoint: https://<your-domain>/api/razorpay/webhook
# Subscribe to: payment.captured, payment.authorized, payment.failed
RAZORPAY_WEBHOOK_SECRET=

# ---- Resend ----------------------------------------------------
# Get this from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxx

# Must be a verified sending address on your Resend domain.
RESEND_FROM_EMAIL=IAES Fairs <fairs@iaesgujarat.org>

# ---- App -------------------------------------------------------
# Base URL of the deployed app. Used to build payment / email links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---- Cron jobs (Netlify Scheduled Functions) -------------------
# Long random string. Cron functions and the corresponding
# /api/cron/* endpoints both check it so external callers can't
# forge automated transitions.
CRON_SECRET=

# ---- Fair-day check-in -----------------------------------------
# Numeric PIN given to door staff. Each device enters it once and it
# is stored in localStorage; the /api/checkin endpoint validates it
# on every scan.
CHECKIN_PIN=
